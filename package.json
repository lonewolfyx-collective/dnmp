{
    "name": "dnmp",
    "type": "module",
    "version": "0.0.0-alpha.0.5",
    "packageManager": "pnpm@10.15.1",
    "description": "Interactive CLI that bumps your version numbers and more",
    "author": "lonewolfyx <olddrivero.king@qq.com>",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/dnmp",
    "bugs": {
        "url": "https://github.com/lonewolfyx/dnmp/issues"
    },
    "keywords": [],
    "bin": {
        "dnmp": "./bin/cli.js"
    },
    "files": [
        "bin",
        "dist"
    ],
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm build",
        "prepare": "simple-git-hooks"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "boxen": "^8.0.1",
        "c12": "^3.3.3",
        "cac": "^6.7.14",
        "find-up": "^8.0.0",
        "glob": "^13.0.0",
        "semver": "^7.7.3",
        "tinyexec": "^1.0.2",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^6.7.3",
        "@lonewolfyx/tsconfig": "^0.0.6",
        "@types/node": "^25.0.3",
        "@types/semver": "^7.7.1",
        "eslint": "^9.39.2",
        "lint-staged": "^16.2.7",
        "picocolors": "^1.1.1",
        "simple-git-hooks": "^2.13.1",
        "tsdown": "^0.18.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "lint-staged": {
        "*": "eslint --fix"
    }
}
